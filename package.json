{
  "name": "manim-cue",
  "displayName": "Manim Cue",
  "description": "See the frames, the timeline and the video of a Manim scene while you edit it in VS Code.",
  "version": "0.3.0",
  "publisher": "behackl",
  "private": true,
  "preview": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/behackl/manim-cue.git" },
  "homepage": "https://github.com/behackl/manim-cue#readme",
  "bugs": { "url": "https://github.com/behackl/manim-cue/issues" },
  "keywords": [
    "manim",
    "animation",
    "preview",
    "timeline",
    "python",
    "video"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:python"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "ms-python.python"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Manim Cue runs scenes only in a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "manimCue.open",
        "title": "Manim Cue: Open Scene",
        "icon": "$(play-circle)"
      },
      {
        "command": "manimCue.refresh",
        "title": "Manim Cue: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "manimCue.refreshTimeline",
        "title": "Manim Cue: Refresh Timeline"
      },
      {
        "command": "manimCue.cancel",
        "title": "Manim Cue: Cancel",
        "icon": "$(debug-stop)"
      },
      {
        "command": "manimCue.preview",
        "title": "Manim Cue: Render Video",
        "icon": "$(device-camera-video)"
      },
      {
        "command": "manimCue.logs",
        "title": "Manim Cue: Show Log"
      },
      {
        "command": "manimCue.clearCaches",
        "title": "Manim Cue: Clear Caches"
      },
      {
        "command": "manimCue.doctor",
        "title": "Manim Cue: Check Python Environment"
      },
      {
        "command": "manimCue.selectPython",
        "title": "Manim Cue: Select Python"
      },
      {
        "command": "manimCue.setupPython",
        "title": "Manim Cue: Set Up Python Environment"
      },
      {
        "command": "manimCue.export",
        "title": "Manim Cue: Save Timeline as JSON"
      },
      { "command": "manimCue.saveFrame", "title": "Manim Cue: Save Frame as PNG" },
      { "command": "manimCue.openExport", "title": "Manim Cue: Export…" },
      { "command": "manimCue.previousFrame", "title": "Manim Cue: Previous Frame" },
      { "command": "manimCue.nextFrame", "title": "Manim Cue: Next Frame" }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "manimCue",
          "title": "Manim Cue",
          "icon": "resources/cue.svg"
        }
      ]
    },
    "views": {
      "manimCue": [
        {
          "id": "manimCue.timeline",
          "name": "Timeline",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "manimCue.open",
          "when": "resourceLangId == python",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "manimCue.refresh",
          "when": "view == manimCue.timeline",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Manim Cue",
      "properties": {
        "manimCue.pythonPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "The Python executable for Manim Cue. Leave it empty to use the interpreter from \"Python: Select Interpreter\" for the scene file."
        },
        "manimCue.autoRefreshOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Update the frame, the timeline and the video when you save the scene file. After a change to another file, use Refresh."
        },
        "manimCue.renderVideoAutomatically": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Render the video after the frame and the timeline."
        },
        "manimCue.autoPreview": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "Render the video after the frame and the timeline.",
          "deprecationMessage": "Use \"Render Video Automatically\" (manimCue.renderVideoAutomatically)."
        },
        "manimCue.frameRate": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 120,
          "description": "The frame rate of the preview, in frames per second. Animations and updaters run at this rate."
        },
        "manimCue.previewWidth": {
          "type": "integer",
          "scope": "resource",
          "default": 960,
          "minimum": 64,
          "maximum": 3840,
          "description": "The width of the preview in pixels. The height follows the aspect ratio of the Manim configuration."
        },
        "manimCue.workingDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "The working folder for the scene, as a full path or relative to the workspace. Leave it empty to use the workspace folder, or the folder of the scene file outside a workspace."
        },
        "manimCue.timeoutSeconds": {
          "type": "integer",
          "default": 600,
          "minimum": 5,
          "maximum": 7200,
          "description": "The maximum time in seconds for one update or render."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:python": "uv run --no-project python -m unittest discover -s test -p \"*_test.py\"",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "test:vscode": "node test/vscode/run.cjs",
    "test:vscode:activation": "node test/vscode/run.cjs --activation",
    "test:ui": "pnpm build && tsx --test test/browser/*.test.ts",
    "package": "pnpm build && vsce package --no-dependencies",
    "package:pre-release": "pnpm build && vsce package --pre-release --no-dependencies"
  },
  "dependencies": {
    "@vscode/python-extension": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.5.1"
}
